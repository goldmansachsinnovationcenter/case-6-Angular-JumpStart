{
  "name": "angular-jump-start",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "node server.js",
    "build": "ng build angular-jumpstart",
    "build:react": "webpack --config webpack.react.config.js",
    "start:react": "webpack serve --config webpack.react.config.js",
    "cypress": "concurrently \"npm start\" \"npx cypress open\"",
    "cypress:headless": "concurrently \"npm start\" \"npx cypress run\"",
    "test-e2e": "concurrently \"npm start\" \"npx cypress run --config-file ./test-e2e/cypress.config.ts\"",
    "test-e2e:open": "concurrently \"npm start\" \"npx cypress open --config-file ./test-e2e/cypress.config.ts\"",
    "test-vrt": "concurrently \"npm start\" \"npx playwright test --config=test-vrt/playwright.config.ts\"",
    "test-vrt:update": "concurrently \"npm start\" \"npx playwright test --config=test-vrt/playwright.config.ts --update-snapshots\"",
    "playground": "angular-playground",
    "docs:json": "compodoc -p ./tsconfig.json -e json -d .",
    "storybook": "npm run docs:json && start-storybook -p 6006",
    "build-storybook": "npm run docs:json && build-storybook"
  },
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.0.2",
    "@mui/material": "^7.0.2",
    "@ngx-env/builder": "^18.0.2",
    "@tanstack/react-query": "^5.72.2",
    "@tanstack/react-router": "^1.115.2",
    "@types/node": "^22.14.0",
    "@types/styled-components": "^5.1.34",
    "express": "^4.21.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rxjs": "~7.8.0",
    "styled-components": "^6.1.17",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.12",
    "@angular/cli": "^18.2.12",
    "@angular/compiler-cli": "^18.2.0",
    "@playwright/test": "^1.51.1",
    "@types/google.maps": "^3.58.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.2",
    "concurrently": "^9.1.2",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.3",
    "open": "^10.1.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.2",
    "typescript": "~5.5.2",
    "webpack": "^5.99.5",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.1"
  },
  "optionalDependencies": {
    "cypress": "^13.15.2"
  }
}
